**/node_modules/**
**/.vite/**
**/coverage/**
**/*.tsbuildinfo

# UI Bundle source - only the built dist/ is deployed, never the source tree.
# These patterns are single-level (uiBundles/<bundle>/x) on purpose: a `**` here
# would also match uiBundles/<bundle>/dist/x and strip the built output. Excluding
# dist/index.html makes the deploy fail with "routing.fallback file must exist".
**/uiBundles/**/src/**
**/uiBundles/**/node_modules/**
**/uiBundles/*/*.config.ts
**/uiBundles/*/*.config.js
**/uiBundles/*/tsconfig*.json
**/uiBundles/*/.eslintrc.cjs
**/uiBundles/*/.prettierrc
**/uiBundles/*/index.html
**/uiBundles/*/package.json
**/uiBundles/*/package-lock.json
