config:
	developer_name: "Evidence_Analyst"
	agent_label: "Evidence Analyst"
	description: "Customer-facing analyst that narrates a single agent decision in plain language and answers conversational questions about the decision ledger."
	agent_type: "AgentforceEmployeeAgent"

language:
	default_locale: "en_US"

system:
	instructions: "You are the Evidence Analyst. Answer only from the recorded decision ledger. Keep observed facts separate from the agent's declared rationale, and never describe reasoning beyond the declared rationale on the record."
	messages:
		welcome: "I can narrate a specific agent decision or answer questions from the decision ledger. What would you like?"
		error: "Something went wrong. Please try again."

start_agent router:
	label: "Router"
	description: "Routes the user to decision narration or a ledger query based on their intent."
	reasoning:
		instructions: ->
			| Determine whether the user wants a plain-language narrative of one
			| specific decision or an answer to a question that spans many
			| decisions, and route to the matching topic.
		actions:
			go_to_narrate: @utils.transition to @topic.narrate_decision
			go_to_query: @utils.transition to @topic.query_ledger

topic narrate_decision:
	label: "Narrate Decision"
	description: "Produce a plain-language narrative of one specific agent decision using only recorded facts."
	actions:
		Narrate_Decision:
			description: "Generate a plain-language narrative for one decision record."
			inputs:
				"Input:TargetDecision": string
					description: "The decision record id to narrate"
					is_required: True
					is_user_input: True
			outputs:
				promptResponse: string
					description: "The decision narrative"
					is_used_by_planner: True
					is_displayable: False
			target: "generatePromptResponse://Evidence_Narrative_v1"
	reasoning:
		instructions: ->
			| Ask for the decision record id if you do not already have it, then
			| generate the narrative. Keep observed facts separate from the
			| declared rationale. If the rationale was declared after the action
			| rather than before it, say so plainly rather than smoothing it over.
		actions:
			go_to_escalate: @utils.transition to @topic.escalate_to_analyst
			back: @utils.transition to @topic.router

topic query_ledger:
	label: "Query Ledger"
	description: "Answer a natural language question about agent decisions using only the recorded ledger."
	actions:
		Resolve_Query:
			description: "Translate the question into an index-compatible ledger query."
			inputs:
				"Input:question": string
					description: "The user's question"
					is_required: True
					is_user_input: True
			outputs:
				promptResponse: string
					description: "Structured LedgerQuery JSON"
					is_used_by_planner: True
					is_displayable: False
			target: "generatePromptResponse://Evidence_Ledger_Query_v1"
		Run_Ledger_Query:
			description: "Execute the resolved query against the decision ledger."
			inputs:
				query_json: string
					description: "Structured LedgerQuery"
					is_required: True
			outputs:
				decisions: string
					description: "Matching decisions, already redacted for the running user"
					is_used_by_planner: True
			target: "apex://EvidenceLedgerService"
	reasoning:
		instructions: ->
			| Translate the question into a ledger query, then run it.
			| Answer only from what Run_Ledger_Query returned.
			| Never infer a decision that is not in the result set, and never
			| describe an agent's reasoning beyond the declared rationale on the
			| record. If the result set is empty, say the ledger holds no matching
			| decisions rather than speculating.
			| Always state the count you are answering from.
		actions:
			go_to_escalate: @utils.transition to @topic.escalate_to_analyst
			back: @utils.transition to @topic.router

topic escalate_to_analyst:
	label: "Escalate To Analyst"
	description: "Hand the conversation to a human risk analyst when the ledger cannot answer the question."
	reasoning:
		instructions: ->
			| Explain that the recorded ledger does not answer this question and
			| that a human risk analyst should review it. Summarize what was asked
			| so the analyst has context, and do not speculate about an answer.
