<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Autolaunched. Lets a customer wire their own approval process into a decision record. In: decisionId, approverId. Out: resultMessage.</description>
    <environments>Default</environments>
    <interviewLabel>Evidence Approval Recorded {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Evidence Approval Recorded Flow</label>
    <processType>AutoLaunchedFlow</processType>
    <status>Active</status>
    <formulas>
        <name>Approval_Message</name>
        <dataType>String</dataType>
        <expression>"Approval recorded for decision " &amp; {!decisionId} &amp; " by approver " &amp; {!approverId} &amp; "."</expression>
    </formulas>
    <assignments>
        <name>Set_Result_Message</name>
        <label>Set Result Message</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Approval_Message</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Set_Result_Message</targetReference>
        </connector>
    </start>
    <variables>
        <name>decisionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>approverId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>resultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
