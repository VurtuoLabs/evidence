<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <description>Screen flow. Guided bundle assembly: matter, range, filter, redaction profile, preview and seal.</description>
    <environments>Default</environments>
    <interviewLabel>Evidence Assemble Bundle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Evidence Assemble Bundle Screen</label>
    <processType>Flow</processType>
    <status>Active</status>
    <formulas>
        <name>Bundle_Summary</name>
        <dataType>String</dataType>
        <expression>"Draft bundle for matter '" &amp; {!matterInput} &amp; "' from " &amp; TEXT({!rangeStartInput}) &amp; " to " &amp; TEXT({!rangeEndInput}) &amp; " using redaction profile '" &amp; {!redactionProfileInput} &amp; "'."</expression>
    </formulas>
    <assignments>
        <name>Set_Result_Message</name>
        <label>Set Result Message</label>
        <locationX>176</locationX>
        <locationY>278</locationY>
        <assignmentItems>
            <assignToReference>resultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Bundle_Summary</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Preview_Bundle</targetReference>
        </connector>
    </assignments>
    <screens>
        <name>Bundle_Details</name>
        <label>Bundle Details</label>
        <locationX>176</locationX>
        <locationY>158</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <connector>
            <targetReference>Set_Result_Message</targetReference>
        </connector>
        <fields>
            <name>Intro</name>
            <fieldText>&lt;p&gt;Assemble a draft evidence bundle. Sealing verifies the chain segment and computes the segment root hash.&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>matterInput</name>
            <dataType>String</dataType>
            <fieldText>Matter</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>purposeInput</name>
            <dataType>String</dataType>
            <fieldText>Purpose</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>false</isRequired>
        </fields>
        <fields>
            <name>rangeStartInput</name>
            <dataType>Date</dataType>
            <fieldText>Range Start</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>rangeEndInput</name>
            <dataType>Date</dataType>
            <fieldText>Range End</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <fields>
            <name>redactionProfileInput</name>
            <dataType>String</dataType>
            <fieldText>Redaction Profile</fieldText>
            <fieldType>InputField</fieldType>
            <isRequired>true</isRequired>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <screens>
        <name>Preview_Bundle</name>
        <label>Preview Bundle</label>
        <locationX>176</locationX>
        <locationY>398</locationY>
        <allowBack>true</allowBack>
        <allowFinish>true</allowFinish>
        <allowPause>false</allowPause>
        <fields>
            <name>Preview</name>
            <fieldText>&lt;p&gt;{!resultMessage}&lt;/p&gt;</fieldText>
            <fieldType>DisplayText</fieldType>
        </fields>
        <showFooter>true</showFooter>
        <showHeader>true</showHeader>
    </screens>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Bundle_Details</targetReference>
        </connector>
    </start>
    <variables>
        <name>resultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
</Flow>
