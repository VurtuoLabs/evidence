<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Evidence Administrator</label>
    <description>Configuration and permission set assignment. Grants Evidence_View_Ledger and Evidence_Verify_Chain and deliberately excludes Evidence_View_Subject_Data for separation of duties.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <applicationVisibilities>
        <application>Evidence</application>
        <visible>true</visible>
    </applicationVisibilities>

    <userPermissions>
        <name>CustomizeApplication</name>
        <enabled>true</enabled>
    </userPermissions>
    <userPermissions>
        <name>ViewRoles</name>
        <enabled>true</enabled>
    </userPermissions>
    <userPermissions>
        <name>ViewSetup</name>
        <enabled>true</enabled>
    </userPermissions>
    <userPermissions>
        <name>ManageProfilesPermissionsets</name>
        <enabled>true</enabled>
    </userPermissions>
    <userPermissions>
        <name>ManageCustomPermissions</name>
        <enabled>true</enabled>
    </userPermissions>

    <customPermissions>
        <name>Evidence_View_Ledger</name>
        <enabled>true</enabled>
    </customPermissions>
    <customPermissions>
        <name>Evidence_Verify_Chain</name>
        <enabled>true</enabled>
    </customPermissions>

    <objectPermissions>
        <object>Decision_Record__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Consideration__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Policy_Check__c</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Chain_Verification__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <fieldPermissions>
        <field>Decision_Record__c.Ledger_Key__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Record__c.Agent_API_Name__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Record__c.Agent_Version__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Record__c.Occurred_At__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Record__c.Headline__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Record__c.Outcome__c</field>
        <readable>true</readable>
        <editable>false</editable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Decision_Record__c.Autonomy_Level__c</field>
